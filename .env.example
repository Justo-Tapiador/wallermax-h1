# ──────────────────────────────────────────────────────────────────────
# Wallermax H1 — environment configuration
# Copy this file to `.env` and edit values. All keys are OPTIONAL.
# ──────────────────────────────────────────────────────────────────────

# ── HTTP server ────────────────────────────────────────────────────────
# TCP port the native Node.js server will listen on.
PORT=4317
# Bind address. Use 0.0.0.0 to expose on the LAN (use with care).
HOST=127.0.0.1
# Optional basic-auth credentials. Leave blank to disable.
WALLERMAX_USER=
WALLERMAX_PASS=

# ── LLM provider ───────────────────────────────────────────────────────
# Which provider to use: "openai" | "zai" | "mock"
# - "openai"  : faithful to World Compiler v2/v3 (uses OpenAI Responses API).
# - "zai"     : uses the z-ai-web-dev-sdk (works inside the Z.ai sandbox).
# - "mock"    : returns a canned World Model — great for UI demos and tests
#               that must never call a real LLM.
LLM_PROVIDER=mock

# ── OpenAI provider settings ───────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Use the Responses API ("responses") or the Chat Completions API ("chat").
OPENAI_MODE=chat

# ── ZAI provider settings ──────────────────────────────────────────────
# No key required inside the Z.ai sandbox. Outside it, set ZAI_API_KEY.
ZAI_API_KEY=

# ── Pipeline defaults ──────────────────────────────────────────────────
# Where to store generated artifacts (world.json, scene_report.md, render.mp4).
# Relative paths are resolved against the project root.
WALLERMAX_WORKDIR=./.wallermax
# Path to the Blender executable. If "blender" is on PATH this can stay default.
BLENDER_BIN=blender
# Set to "1" to skip Blender entirely and only produce the World Model JSON.
SKIP_BLENDER=0
# Default render settings (overridable from the web UI per request).
# These are tuned for FAST preview renders. Bump them up once you confirm
# the pipeline produces a valid MP4. For a quick test:
#   width=640, height=360, fps=24, duration=2 → 48 frames, ~3-5 min on a
#   modern laptop with EEVEE.
DEFAULT_RENDER_WIDTH=640
DEFAULT_RENDER_HEIGHT=360
DEFAULT_RENDER_FPS=24
DEFAULT_RENDER_DURATION=2
# Max upload size for any single image, in bytes (default 20 MiB).
MAX_UPLOAD_BYTES=20971520
