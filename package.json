{
  "name": "wallermax-h1",
  "version": "1.0.1", 
  "description": "Wallermax H1 — Procedural 3D scene compiler. Text + reference image + final image -> semantic World Model -> Blender -> MP4. Native Node.js + TypeScript web server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx server/src/cli.ts"
  },
  "dependencies": {
    "formidable": "^3.5.2",
    "openai": "^4.77.0",
    "z-ai-web-dev-sdk": "*"
  },
  "devDependencies": {
    "@types/formidable": "^3.4.5",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
