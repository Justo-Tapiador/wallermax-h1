{
  "name": "wallermax-h1",
  "version": "1.0.0",
  "description": "Wallermax H1 — Beta prototype of a video generator based on 3D scene rendering. Sends prompt + images to an LLM, receives a declarative World Model JSON, and compiles it into an MP4 via Blender + Python.",
  "author": "Justo Tapiador García",
  "license": "MIT",
  "keywords": [
    "blender",
    "3d-rendering",
    "video-generation",
    "llm",
    "procedural",
    "animation",
    "mp4",
    "world-model",
    "scene-compiler",
    "typescript",
    "python",
    "ffmpeg",
    "eevee",
    "cycles",
    "pillow"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx server/src/cli.ts"
  },
  "files": [
    "server/src/",
    "python/",
    "schemas/",
    "prompts/",
    "public/",
    "docs/",
    "download/",
    ".env.example",
    "tsconfig.json",
    "README.md"
  ],
  "dependencies": {
    "formidable": "^3.5.2",
    "openai": "^4.77.0",
    "z-ai-web-dev-sdk": "*"
  },
  "devDependencies": {
    "@types/formidable": "^3.4.5",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}